# =============================================
# n8n — Interface Web
# =============================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# URL pública do n8n (usada para os webhooks)
# Exemplo: http://192.168.1.100:5678
WEBHOOK_URL=http://SEU_IP:5678

# Autenticação básica da interface do n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=senha_segura_aqui

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# =============================================
# PostgreSQL — Banco de dados do n8n
# =============================================
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=senha_postgres_segura_aqui

# =============================================
# Agente Windows (windows-service-agent.ps1)
# Porta e chave devem coincidir com o instalado em cada servidor Windows
# =============================================
WIN_AGENT_PORT=8881
WIN_AGENT_KEY=troque-por-chave-segura-aqui

# =============================================
# ManageEngine Endpoint Central (opcional — inventário/outros usos)
# =============================================
ECENTRAL_URL=https://SEU_ECENTRAL:8383
ECENTRAL_API_KEY=sua_api_key_aqui

# =============================================
# Zabbix API — Para adicionar comentários nos eventos
# =============================================
ZABBIX_URL=https://SEU_ZABBIX
ZABBIX_API_TOKEN=seu_token_api_zabbix_aqui
# Zabbix com certificado autoassinado — desabilita verificação SSL no n8n
NODE_TLS_REJECT_UNAUTHORIZED=0

# =============================================
# Notificações de Escalada (falha de remediação)
# =============================================
# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Slack
SLACK_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alertas@suaempresa.com
SMTP_TO=ti@suaempresa.com
