      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Zabbix API — Comentar Evento (Falha)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1840, 300]
    },
    {
      "parameters": {
        "jsCode": "const norm = $('Normalizar Campos').item.json;\nconst logInfo = ($('Buscar Log Windows').item.json.result?.value || '').trim() || 'Nao disponivel';\nconst now = new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\nreturn [{\n  json: {\n    teams_body: JSON.stringify({\n      '@type': 'MessageCard',\n      '@context': 'http://schema.org/extensions',\n      themeColor: 'FF0000',\n      summary: 'Falha de remediacao: ' + norm.service_name + ' em ' + norm.host,\n      sections: [{\n        activityTitle: 'Falha ao Reiniciar Servico',\n        activitySubtitle: norm.host,\n        facts: [\n          { name: 'Servico',              value: norm.service_name },\n          { name: 'Severidade',           value: norm.severity },\n          { name: 'Trigger',              value: norm.trigger_name },\n          { name: 'Hora',                 value: now },\n          { name: 'Ultimo evento no log', value: logInfo }\n        ],\n        markdown: true\n      }]\n    })\n  }\n}];"
      },
