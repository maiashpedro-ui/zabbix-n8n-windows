{
  "name": "Zabbix — Remediação de Serviços Windows",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "zabbix-alert",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Webhook Zabbix",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "zabbix-alert"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-host",
              "name": "host",
              "value": "={{ $json.body.host }}",
              "type": "string"
            },
            {
              "id": "field-ip",
              "name": "ip",
              "value": "={{ $json.body.ip }}",
              "type": "string"
            },
            {
              "id": "field-service",
              "name": "service_name",
              "value": "={{ $json.body.service_name.replace(/^service\\.info\\[/, '').replace(/,.*$/, '') }}",
              "type": "string"
            },
            {
              "id": "field-event-type",
              "name": "event_type",
              "value": "={{ $json.body.event_type }}",
              "type": "string"
            },
            {
              "id": "field-event-id",
              "name": "event_id",
              "value": "={{ $json.body.event_id }}",
              "type": "string"
            },
            {
              "id": "field-trigger",
              "name": "trigger_name",
              "value": "={{ $json.body.trigger_name }}",
              "type": "string"
            },
            {
              "id": "field-severity",
              "name": "severity",
              "value": "={{ $json.body.severity }}",
              "type": "string"
            },
            {
              "id": "field-timestamp",
              "name": "timestamp",
              "value": "={{ $json.body.timestamp }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Normalizar Campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-problem",
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "PROBLEM",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "É um PROBLEMA?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "sshPassword",
        "host": "={{ $json.ip }}",
        "port": 22,
        "username": "={{ $env.WIN_SSH_USER || 'administrator' }}",
        "command": "powershell -NonInteractive -Command \"try { Start-Service -Name '{{ $json.service_name }}' -ErrorAction Stop; $svc = Get-Service -Name '{{ $json.service_name }}'; Write-Output $svc.Status } catch { Write-Error $_.Exception.Message; exit 1 }\"",
        "options": {
          "allowedHosts": "any"
        }
      },
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "SSH — Reiniciar Serviço",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [900, 180],
      "credentials": {
        "sshPassword": {
          "id": "SSH_CREDENTIAL_ID",
          "name": "Windows Servers SSH"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "cond-running",
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "Running",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Serviço Reiniciado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZABBIX_URL }}/api_jsonrpc.php",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.ZABBIX_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"event.acknowledge\",\n  \"params\": {\n    \"eventids\": [\"{{ $('Normalizar Campos').item.json.event_id }}\"],\n    \"action\": 4,\n    \"message\": \"[n8n] Serviço '{{ $('Normalizar Campos').item.json.service_name }}' reiniciado automaticamente em {{ $('Normalizar Campos').item.json.host }} em {{ $now.toFormat('dd/MM/yyyy HH:mm:ss') }}\"\n  },\n  \"id\": 1\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Zabbix API — Comentar Evento (Sucesso)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZABBIX_URL }}/api_jsonrpc.php",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.ZABBIX_API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"event.acknowledge\",\n  \"params\": {\n    \"eventids\": [\"{{ $('Normalizar Campos').item.json.event_id }}\"],\n    \"action\": 4,\n    \"message\": \"[n8n] FALHA ao reiniciar serviço '{{ $('Normalizar Campos').item.json.service_name }}' em {{ $('Normalizar Campos').item.json.host }}. Intervenção manual necessária.\"\n  },\n  \"id\": 1\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Zabbix API — Comentar Evento (Falha)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TEAMS_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"@type\": \"MessageCard\",\n  \"@context\": \"http://schema.org/extensions\",\n  \"themeColor\": \"FF0000\",\n  \"summary\": \"Falha de Remediação — {{ $('Normalizar Campos').item.json.host }}\",\n  \"sections\": [{\n    \"activityTitle\": \"Falha ao Reiniciar Serviço\",\n    \"activitySubtitle\": \"{{ $('Normalizar Campos').item.json.host }} ({{ $('Normalizar Campos').item.json.ip }})\",\n    \"facts\": [\n      { \"name\": \"Serviço\", \"value\": \"{{ $('Normalizar Campos').item.json.service_name }}\" },\n      { \"name\": \"Severidade\", \"value\": \"{{ $('Normalizar Campos').item.json.severity }}\" },\n      { \"name\": \"Trigger\", \"value\": \"{{ $('Normalizar Campos').item.json.trigger_name }}\" },\n      { \"name\": \"Hora\", \"value\": \"{{ $now.toFormat('dd/MM/yyyy HH:mm:ss') }}\" }\n    ],\n    \"markdown\": true\n  }]\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Teams — Escalada de Falha",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 280]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"ok\", \"message\": \"Evento recebido\" }",
        "options": {}
      },
      "id": "a1b2c3d4-0009-0009-0009-000000000009",
      "name": "Resposta HTTP 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 480]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "log-recovery",
              "name": "log",
              "value": "={{ 'Recuperação recebida para ' + $json.host + ' — serviço ' + $json.service_name + ' em ' + $now.toFormat('dd/MM/yyyy HH:mm:ss') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0010-0010-0010-000000000010",
      "name": "Log Recuperação",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 420]
    }
  ],
  "connections": {
